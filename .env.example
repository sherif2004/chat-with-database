AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=<the capable model, e.g. gpt-4.1-mini - used for generate_sql>
AZURE_OPENAI_DEPLOYMENT_LIGHT=<the cheap model, e.g. gpt-4.1-nano - used for classify_intent, generate_answer>
# AZURE_OPENAI_API_VERSION=2025-03-01-preview
# LLM_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql://user:password@host:port/railway
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=   (only for Qdrant Cloud)

# Required to save custom database connections (encrypts their URLs at rest).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Seeds (or promotes) this account as admin on every startup. Set both.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# MAX_WRITE_ROWS=100   (most rows one confirmed admin change may touch)
# SESSION_TTL_DAYS=14
# COOKIE_SECURE=true   (set when served over HTTPS)
# CORS_ORIGINS=http://localhost:5173   (comma-separated)

REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=3600

# Refuse user-supplied database hosts on private/loopback addresses.
# Set to false if the databases people connect are on a private network.
# BLOCK_PRIVATE_HOSTS=true
